// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlessingMessage {
  id           String                       @id @default(uuid()) @db.Uuid
  active       Boolean                      @default(true)
  priority     Int                          @default(0)
  publishedAt  DateTime?                    @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations BlessingMessageTranslation[]

  @@map("blessing_messages")
}

model BlessingMessageTranslation {
  id                 String          @id @default(uuid()) @db.Uuid
  messageId          String          @map("message_id") @db.Uuid
  locale             String          @db.VarChar(5)
  title              String?
  body               String
  scriptureReference String?         @map("scripture_reference")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  message            BlessingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, locale])
  @@map("blessing_message_translations")
}

model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  sessionId       String   @map("session_id")
  path            String
  locale          String   @db.VarChar(5)
  countryCode     String?  @map("country_code") @db.VarChar(2)
  countryName     String?  @map("country_name")
  regionCode      String?  @map("region_code")
  regionName      String?  @map("region_name")
  city            String?
  referrer        String?
  userAgentFamily String?  @map("user_agent_family")
  deviceType      String?  @map("device_type")
  isPublic        Boolean  @default(true) @map("is_public")

  @@index([occurredAt])
  @@index([locale])
  @@index([isPublic, occurredAt])
  @@map("analytics_events")
}

model Subscriber {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  locale         String    @db.VarChar(5)
  status         String    @default("pending")
  subscribedAt   DateTime? @map("subscribed_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("unsubscribed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscribers")
}

model User {
  id                 String    @id
  name               String
  email              String
  emailVerified      Boolean   @default(false)
  image              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  mustChangePassword Boolean?  @default(true)
  twoFactorEnabled   Boolean   @default(false)
  phone              String?
  whatsapp           String?
  telegramChatId     String?
  active             Boolean   @default(true)
  prayerTelegramAlertsEnabled Boolean @default(false) @map("prayer_telegram_alerts_enabled")
  prayerEmailCopiesEnabled    Boolean @default(false) @map("prayer_email_copies_enabled")
  sessions           Session[]
  accounts           Account[]
  roles              UserRole[]
  auditEvents        AuditLog[] @relation("AuditActor")
  twoFactor          TwoFactor?
  notificationPreference NotificationPreference?
  prayerNotifications PrayerNotification[]
  invitations UserInvitation[]
  media              ContentMedia[] @relation("MediaCreator")

  @@unique([email])
  @@map("user")
}

model MinistryContact {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  ministry       String
  phone          String?
  whatsapp       String?
  telegramChatId String?  @map("telegram_chat_id")
  locale         String   @default("en") @db.VarChar(5)
  timezone       String   @default("America/Los_Angeles")
  authorized     Boolean  @default(false)
  active         Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments    PrayerAssignment[]
  availability    UsherAvailability[]

  @@index([ministry])
  @@map("ministry_contacts")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean   @default(false)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("twoFactor")
}

enum ApplicationRole {
  SUPER_ADMIN
  ADMIN
  TREASURER
  USHER
}

model UserRole {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String
  role      ApplicationRole
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id")
  action      String
  resource    String
  resourceId  String?   @map("resource_id")
  metadata    Json?     @map("metadata")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

model BootstrapState {
  key         String   @id
  completedAt DateTime @map("completed_at") @db.Timestamptz(6)

  @@map("bootstrap_states")
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum PrayerRequestType {
  PRAYER_ONLY
  PRAYER_AND_CONTACT
}

enum PrayerRequestStatus {
  NEW
  PENDING_ASSIGNMENT
  ASSIGNED
  CONTACTED
  CLOSED
}

model PrayerRequest {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  message           String              @db.Text
  email             String?
  requestType       PrayerRequestType   @default(PRAYER_ONLY) @map("request_type")
  country           String?             @db.VarChar(2)
  contactChannel    String?             @map("contact_channel")
  phone             String?
  whatsapp          String?
  timeZone          String?             @map("time_zone") @db.VarChar(64)
  availabilitySlotId String?            @map("availability_slot_id") @db.Uuid
  consentToStore    Boolean             @default(false) @map("consent_to_store")
  consentToContact  Boolean             @default(false) @map("consent_to_contact")
  status            PrayerRequestStatus @default(NEW)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments       PrayerAssignment[]
  availabilitySlot  UsherAvailability?  @relation(fields: [availabilitySlotId], references: [id], onDelete: SetNull)
  notifications     PrayerNotification[]

  @@index([status, createdAt])
  @@index([requestType, createdAt])
  @@index([country])
  @@map("prayer_requests")
}

model PrayerAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  requestId       String        @map("request_id") @db.Uuid
  contactId       String?       @map("contact_id") @db.Uuid
  usherName       String        @map("usher_name")
  assignedById    String        @map("assigned_by_id")
  assignedAt      DateTime      @default(now()) @map("assigned_at") @db.Timestamptz(6)
  request         PrayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  contact         MinistryContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([contactId])
  @@map("prayer_assignments")
}

model UsherAvailability {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String?  @map("contact_id") @db.Uuid
  usherName String   @map("usher_name")
  timezone  String
  weekday   Int
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  active    Boolean  @default(true)
  contact   MinistryContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  prayerRequests PrayerRequest[]

  @@index([usherName, weekday])
  @@index([contactId, weekday])
  @@map("usher_availability")
}

enum PrayerNotificationType {
  NEW_PRAYER_REQUEST
  NEW_CONTACT_REQUEST
  PENDING_ASSIGNMENT
  ASSIGNMENT_MADE
}

model PrayerNotification {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id")
  type      PrayerNotificationType
  requestId String?               @map("request_id") @db.Uuid
  title     String
  read      Boolean               @default(false)
  readAt    DateTime?             @map("read_at") @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   PrayerRequest?        @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@map("prayer_notifications")
}

model UserInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id")
  email       String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_invitations")
}

model NotificationPreference {
  id                   String   @id
  userId               String   @unique @map("user_id")
  newPrayerRequest     Boolean  @default(true) @map("new_prayer_request")
  newContactRequest    Boolean  @default(true) @map("new_contact_request")
  pendingAssignment    Boolean  @default(true) @map("pending_assignment")
  assignmentMade       Boolean  @default(true) @map("assignment_made")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum DonationStatus {
  PENDING
  APPROVED
  COMPLETED
  FAILED
  CANCELLED
  CONFIRMED
  REFUNDED
}
model Donation {
  id String @id @default(uuid()) @db.Uuid
  provider String
  externalReference String @unique @map("external_reference")
  amount Decimal @db.Decimal(12,2)
  currency String @db.VarChar(3)
  campaign String
  fund String?
  status DonationStatus @default(PENDING)
  reconciledAt DateTime? @map("reconciled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  webhookEvents DonationWebhookEvent[]
  @@index([provider,status])
  @@map("donations")
}
model DonationWebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String
  externalId String @map("external_id")
  eventType String @map("event_type")
  verified Boolean @default(false)
  processed Boolean @default(false)
  donationId String? @map("donation_id") @db.Uuid
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)
  @@unique([provider, externalId])
  @@index([provider,processed])
  @@map("donation_webhook_events")
}

model ContentBlock {
  id           String               @id @default(uuid()) @db.Uuid
  key          String               @unique
  type         String
  displayOrder Int                  @default(0) @map("display_order")
  status       ContentStatus        @default(DRAFT)
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  translations ContentTranslation[]
  revisions    ContentRevision[]

  @@map("content_blocks")
}

model ContentTranslation {
  id        String       @id @default(uuid()) @db.Uuid
  blockId   String       @map("block_id") @db.Uuid
  locale    String       @db.VarChar(5)
  draft     Json
  published Json?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  block     ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([blockId, locale])
  @@map("content_translations")
}

model ContentRevision {
  id          String       @id @default(uuid()) @db.Uuid
  blockId     String       @map("block_id") @db.Uuid
  locale      String?      @db.VarChar(5)
  action      String?
  snapshot    Json
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  block       ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, createdAt])
  @@map("content_revisions")
}

model ContentMedia {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @unique
  mimeType    String   @map("mime_type") @db.VarChar(32)
  byteSize    Int      @map("byte_size")
  width       Int
  height      Int
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   User?    @relation("MediaCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("content_media")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
