# PostgreSQL database dedicated to suPlenitud; never reuse n8n credentials.
DATABASE_URL="postgresql://suplenitud_app:CHANGE_ME@localhost:5432/suplenitud_web?schema=public"

# Public canonical URL for this isolated demo environment.
NEXT_PUBLIC_SITE_URL="https://demo.suplenitud.com"
# Server-only canonical URL for admin links (webhook payloads, audit refs).
# Never derived from request Host/Origin; no silent demo fallback in prod.
APP_ADMIN_URL=""

# Persistent storage directory for CMS media (uploaded images). Point this at a
# mounted volume in deployment; leave empty to keep image uploads disabled. The
# app never creates it at build time and stores no host paths in the database.
CMS_MEDIA_DIR=""

# Visitor geography (optional). Trust X-Forwarded-For ONLY behind controlled
# Traefik; enabling it elsewhere lets clients spoof their origin. The visitor
# IP is used in memory for one GeoLite2 lookup per request and is discarded
# immediately: it is never stored, hashed, or logged.
GEO_TRUST_PROXY_HEADERS=false
PRAYER_REQUESTS_PUBLIC_ENABLED=true
# Local GeoLite2-City database file (MaxMind DB format). Download it out of
# band with a licensed MaxMind account; never commit the file or any license
# key. When empty or missing, analytics keeps working without country/state.
# Example future mount: /opt/suplenitud-demo/geoip/GeoLite2-City.mmdb
GEOIP_DATABASE_PATH=""

# Administrative authentication. Generate and store these only in the local/VPS
# secret store; never commit real values.
BETTER_AUTH_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_VALUE"
BETTER_AUTH_URL="https://demo.suplenitud.com"

# One-time SuperAdmin bootstrap. These values are consumed only by the local
# bootstrap operation and must be removed immediately after a successful run.
INITIAL_SUPERADMIN_EMAIL="jscothserver@gmail.com"
INITIAL_SUPERADMIN_PASSWORD="CHANGE_ME_TEMPORARILY"
ENABLE_INITIAL_SUPERADMIN_BOOTSTRAP=false

# Outgoing mail for user invitations (MailCow SMTP). Store real values only in
# the deployment secret store; never commit them. Invitations are the only
# template allowed to send in this phase; without these values the API reports
# the mail as not sent instead of pretending delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS="CHANGE_ME"
SMTP_FROM="no-reply@suplenitud.com"

# Future offerings via hosted checkout (PayPal/Square). No credentials exist
# yet, so the system stays fully inactive: no public pay buttons and no real
# calls. Store real values only in the VPS `.env`; never commit them. The
# panel only ever shows readiness state, never secret values.
PAYMENTS_ENABLED=false
PAYMENTS_MODE=sandbox
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET="CHANGE_ME"
PAYPAL_WEBHOOK_ID=""
SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""
SQUARE_ACCESS_TOKEN="CHANGE_ME"
SQUARE_WEBHOOK_SIGNATURE_KEY="CHANGE_ME"
SQUARE_WEBHOOK_NOTIFICATION_URL=""
