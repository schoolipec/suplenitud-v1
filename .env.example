# PostgreSQL database dedicated to suPlenitud; never reuse n8n credentials.
DATABASE_URL="postgresql://suplenitud_app:CHANGE_ME@localhost:5432/suplenitud_web?schema=public"

# Public canonical URL for this isolated demo environment.
NEXT_PUBLIC_SITE_URL="https://demo.suplenitud.com"
GEO_TRUST_PROXY_HEADERS=false

# Administrative authentication. Generate and store these only in the local/VPS
# secret store; never commit real values.
BETTER_AUTH_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_VALUE"
BETTER_AUTH_URL="https://demo.suplenitud.com"

# One-time SuperAdmin bootstrap. These values are consumed only by the local
# bootstrap operation and must be removed immediately after a successful run.
INITIAL_SUPERADMIN_EMAIL="jscothserver@gmail.com"
INITIAL_SUPERADMIN_PASSWORD="CHANGE_ME_TEMPORARILY"
ENABLE_INITIAL_SUPERADMIN_BOOTSTRAP=false

# Outgoing mail for user invitations (MailCow SMTP). Store real values only in
# the deployment secret store; never commit them. Invitations are the only
# template allowed to send in this phase; without these values the API reports
# the mail as not sent instead of pretending delivery.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS="CHANGE_ME"
SMTP_FROM="no-reply@suplenitud.com"
